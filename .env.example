# Resend API key for transactional email (leads from the contact form).
# Copy this file to .env.local and fill in a real key from https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# Recipient address(es) for lead emails. Comma-separate multiple addresses.
# Required: the API answers 503 if it is unset or empty.
LEAD_TO_EMAIL=leads@example.com

# Verified sender identity at Resend (must be a domain you own/verified).
# Falls back to onboarding@resend.dev if unset.
RESEND_FROM=Fenix Web <onboarding@resend.dev>
